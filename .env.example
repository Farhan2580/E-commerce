# Export these into the Django process environment; this project does not auto-load .env.
DJANGO_SETTINGS_MODULE=djangoProject13.settings
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Preserve the existing production database. Enable only after verified backup.
DATABASE_URL=
DATABASE_USE_URL=0
DATABASE_SSL_REQUIRE=1
STOREFRONT_URL=http://127.0.0.1:8000
# Notification delivery stays unavailable until these are configured.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=
# Preserve original Cloudinary keys when transferring uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_MEDIA_PREFIX=gadgetflow/media
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Enable only channels confirmed available on your SANDBOX merchant account.
SSLCOMMERZ_CARD_ENABLED=0
SSLCOMMERZ_CARD_BRANDS=
# Supported brand keys: visa,mastercard. Set only after merchant channel approval.
# Production uploads (independent of collected static files).
MEDIA_STORAGE=filesystem
# Set MEDIA_STORAGE=s3 after provisioning storage and transferring originals.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
# Optional HTTPS S3-compatible endpoint, e.g. R2. Leave empty for AWS S3.
AWS_S3_ENDPOINT_URL=
AWS_S3_ADDRESSING_STYLE=auto
AWS_MEDIA_LOCATION=media
# Private bucket: signed URLs by default. Public CDN: set custom hostname and 0.
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=1
SSLCOMMERZ_BKASH_ENABLED=0
PAYMENT_PUBLIC_URL=https://your-public-test-host.example
